diff --git a/packages/server/src/windowControllerShim.ts b/packages/server/src/windowControllerShim.ts
new file mode 100644
index 0000000..47ba340
--- /dev/null
+++ b/packages/server/src/windowControllerShim.ts
@@ -0,0 +1,148 @@
+// 修复依据：直连页侧栏「任务」分组的数据源是 IWindowControllerService（channel
+// "window-controller"，useGlobalTaskList → controllerRegistry.list）。该服务此前只在
+// 桌面 Host（packages/desktop/src/host/index.ts）注册，web 直连页连接自托管 server 时
+// 查询直接超时（Unknown channel: window-controller），任务列表恒空。
+// 远控页不受影响（其列表来自 relay bootstrap 清单）。
+//
+// 本文件提供一个 server 端的最小 Window Controller 实现：把 Window Controller 的
+// 任务列表/变更契约转发到同进程的 IZCodeTaskService（tasks-index.sqlite 同一数据源，
+// 与桌面端 listTaskList 的 local source 投影一致），使自托管 web 直连页获得与桌面端
+// 一致的侧栏任务列表。订阅语义为快照式（无实时帧推送），供开源部署复用。
+import { randomUUID } from "node:crypto";
+import { Emitter, type Event } from "@zcode/rpc";
+import {
+  IWindowControllerService,
+  IZCodeTaskService,
+  type WindowHostControllerFrame,
+  type WindowHostControllerMutation,
+  type WindowHostControllerTaskListItem,
+  type WindowHostControllerTaskListResult,
+  type ZCodeTaskListQuery,
+  type ZCodeArchivedTaskDeletionResult,
+} from "@zcode/services";
+import type { ZCodeTaskMeta } from "@zcode/shared";
+import type {
+  ControllerResyncParams,
+  ControllerResyncResult,
+  ControllerSubscribeParams,
+  ControllerSubscribeResult,
+  ControllerUnsubscribeParams,
+  WindowHostTaskAddress,
+} from "@zcode/shared/zcode-protocol-v4";
+
+// 与桌面端 windowHostControllerService.ts 的 liveStatusFromMeta 同规则
+function liveStatusFromMeta(meta: ZCodeTaskMeta): WindowHostControllerTaskListItem["liveStatus"] {
+  if (meta.status === "completed") return "completed";
+  if (meta.status === "error") return "error";
+  return "idle";
+}
+
+function toListItem(
+  meta: ZCodeTaskMeta,
+  item: { searchSnippet?: string; searchSnippets?: string[] },
+): WindowHostControllerTaskListItem {
+  return {
+    ...meta,
+    ...(item.searchSnippet ? { searchSnippet: item.searchSnippet } : {}),
+    ...(item.searchSnippets ? { searchSnippets: item.searchSnippets } : {}),
+    sourceAvailability: "online",
+    liveStatus: liveStatusFromMeta(meta),
+  };
+}
+
+export function createServerWindowControllerService(options: {
+  taskService: IZCodeTaskService;
+}): IWindowControllerService {
+  const { taskService } = options;
+  // web 场景只消费列表投影；controller V4 订阅帧暂无 server 端发布者，
+  // onDynamicControllerFrame 保持空事件流（订阅方收不到帧时以查询为准）。
+  const dynamicFrameEmitter = new Emitter<WindowHostControllerFrame>();
+
+  function mutationParams(address: WindowHostTaskAddress) {
+    return {
+      taskId: address.taskId,
+      workspacePath: address.workspacePath,
+      ...(address.workspaceIdentity ? { workspaceIdentity: address.workspaceIdentity } : {}),
+    };
+  }
+
+  return {
+    async listTaskList(query: ZCodeTaskListQuery): Promise<WindowHostControllerTaskListResult> {
+      const result = await taskService.listTaskList(query);
+      return {
+        ...result,
+        items: result.items.map((item) => toListItem(item, item)),
+      };
+    },
+
+    async mutateTask(params: {
+      address: WindowHostTaskAddress;
+      mutation: WindowHostControllerMutation;
+    }): Promise<ZCodeTaskMeta | null> {
+      const { address, mutation } = params;
+      const p = mutationParams(address);
+      switch (mutation.kind) {
+        case "pin":
+          return taskService.setTaskPinned({ ...p, pinned: mutation.pinned });
+        case "archive":
+          return mutation.archived
+            ? taskService.archiveTask(p)
+            : taskService.unarchiveTask(p);
+        case "delete":
+          await taskService.deleteTask(p);
+          return null;
+        case "delete-archived":
+          await taskService.deleteArchivedTask(p);
+          return null;
+        case "mark-read":
+          return taskService.setTaskUnread({ ...p, unread: false, ...(mutation.expectedUnreadAt !== undefined ? { expectedUnreadAt: mutation.expectedUnreadAt } : {}) });
+        case "mark-unread":
+          return taskService.setTaskUnread({ ...p, unread: true });
+        case "open":
+        case "resume":
+          // 打开/恢复由 UI 经会话通道处理，不属于持久化变更。
+          return null;
+        default: {
+          const exhaustive: never = mutation;
+          throw new Error(`Unsupported window controller mutation: ${JSON.stringify(exhaustive)}`);
+        }
+      }
+    },
+
+    async deleteArchivedTask(params: { address: WindowHostTaskAddress }): Promise<boolean> {
+      return taskService.deleteArchivedTask(mutationParams(params.address));
+    },
+
+    async deleteArchivedTasks(params: {
+      address: WindowHostTaskAddress;
+      taskIds: string[];
+    }): Promise<ZCodeArchivedTaskDeletionResult> {
+      return taskService.deleteArchivedTasks({
+        workspacePath: params.address.workspacePath,
+        ...(params.address.workspaceIdentity
+          ? { workspaceIdentity: params.address.workspaceIdentity }
+          : {}),
+        taskIds: params.taskIds,
+      });
+    },
+
+    async subscribeControllerV4(
+      _params: ControllerSubscribeParams,
+    ): Promise<ControllerSubscribeResult> {
+      // 快照语义：ack 指示客户端按 snapshot 自行拉列表（本服务无增量帧）。
+      return { ack: { subscriptionId: `srv-${randomUUID()}`, mode: "snapshot", logEpoch: "server" } };
+    },
+
+    async resyncControllerV4(params: ControllerResyncParams): Promise<ControllerResyncResult> {
+      return {
+        ack: { subscriptionId: params.subscriptionId, mode: "snapshot", logEpoch: "server" },
+      };
+    },
+
+    async unsubscribeControllerV4(_params: ControllerUnsubscribeParams): Promise<void> {},
+
+    onDynamicControllerFrame(): Event<WindowHostControllerFrame> {
+      return dynamicFrameEmitter.event;
+    },
+  };
+}
