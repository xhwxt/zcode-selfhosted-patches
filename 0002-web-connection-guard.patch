From 3c82d9ae2a75ad88917c67c9ac44ec6e07e30783 Mon Sep 17 00:00:00 2001
From: xhwxt <xhwxt@users.noreply.github.com>
Date: Wed, 7 Oct 2026 09:23:40 +0800
Subject: [PATCH] fix(web): connection guard for mobile background disconnects
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

手机浏览器切后台数秒即被系统冻结/回收 WebSocket；回前台时 socket 已死且无提示（RPC 静默失败）。
- 非 clean close（非 1000/1001）：提示条 + 页面可见时延迟整页 reload 重走 bootstrap
- 回前台（visibilitychange/online）：后台期间死过 socket 或 /api/server-info 探测失败时整页恢复
- reload 频控 3 次/60s（sessionStorage），超限停止；服务端是事实源，reload 不丢数据
---
 packages/web/src/main.tsx | 107 +++++++++++++++++++++++++++++++++++++-
 1 file changed, 106 insertions(+), 1 deletion(-)

diff --git a/packages/web/src/main.tsx b/packages/web/src/main.tsx
index bb4dea1..fb76628 100644
--- a/packages/web/src/main.tsx
+++ b/packages/web/src/main.tsx
@@ -431,6 +431,110 @@ function renderWebBootstrapError(error: unknown): void {
   );
 }
 
+// ── 连接守卫（手机后台断连恢复）────────────────────────────────────────────
+// 手机浏览器切后台数秒即可被系统冻结/回收 WebSocket；回前台时 socket 可能已死
+// 且无任何提示（RPC 调用静默失败）。兜底策略：close(非正常) 即提示并整页恢复；
+// 回前台时若后台期间死过 socket，或 /api/server-info 探测失败，同样整页恢复。
+// 整页 reload 等价重新走 bootstrap：服务端是事实源（web-remote-replayable 语义），
+// 重连后由 snapshot 补齐会话，本地不持久化业务状态，因此 reload 不丢数据。
+// reload 频率限制在 3 次/60 秒，server 真不可用时停在启动错误屏（有手动重试）。
+
+const GUARD_RELOAD_WINDOW_MS = 60_000;
+const GUARD_RELOAD_MAX = 3;
+const GUARD_RELOAD_KEY = "zcode-web-conn-guard-reloads";
+
+function guardReloadAllowed(): boolean {
+  try {
+    const now = Date.now();
+    const stamps = (JSON.parse(sessionStorage.getItem(GUARD_RELOAD_KEY) ?? "[]") as number[])
+      .filter((t) => now - t < GUARD_RELOAD_WINDOW_MS);
+    if (stamps.length >= GUARD_RELOAD_MAX) return false;
+    stamps.push(now);
+    sessionStorage.setItem(GUARD_RELOAD_KEY, JSON.stringify(stamps));
+    return true;
+  } catch {
+    return true;
+  }
+}
+
+function showWebReconnectOverlay(): void {
+  if (document.getElementById("zcode-web-conn-overlay")) return;
+  const el = document.createElement("div");
+  el.id = "zcode-web-conn-overlay";
+  el.textContent =
+    /^zh\b/i.test(navigator.language) ? "连接已断开，正在重新连接…" : "Connection lost, reconnecting…";
+  el.style.cssText =
+    "position:fixed;left:0;right:0;bottom:0;z-index:2147483647;padding:10px 16px;" +
+    "text-align:center;background:#b91c1c;color:#fff;font:13px/1.4 system-ui,sans-serif;";
+  document.body.appendChild(el);
+}
+
+function reloadWebIfAllowed(): void {
+  if (guardReloadAllowed()) window.location.reload();
+}
+
+function handleWebTransportClosed(event: { wasClean: boolean; code: number }): void {
+  // 正常关闭（主动登出/服务端优雅关闭）不自动重载，避免干扰正常流程
+  if (event.wasClean || event.code === 1000 || event.code === 1001) return;
+  showWebReconnectOverlay();
+  if (document.visibilityState === "visible") {
+    window.setTimeout(reloadWebIfAllowed, 600);
+  }
+}
+
+async function probeServerInfoAlive(): Promise<boolean> {
+  const token = new URLSearchParams(window.location.search).get("token");
+  const url = token ? `/api/server-info?token=${encodeURIComponent(token)}` : "/api/server-info";
+  const ctl = new AbortController();
+  const timer = window.setTimeout(() => ctl.abort(), 4_000);
+  try {
+    const response = await fetch(url, { cache: "no-store", signal: ctl.signal });
+    return response.ok;
+  } catch {
+    return false;
+  } finally {
+    window.clearTimeout(timer);
+  }
+}
+
+function installWebConnectionGuard(): void {
+  let socketDiedWhileHidden = false;
+  let probing = false;
+
+  const recoverOnVisible = async (): Promise<void> => {
+    if (document.visibilityState !== "visible" || probing) return;
+    if (socketDiedWhileHidden) {
+      socketDiedWhileHidden = false;
+      showWebReconnectOverlay();
+      window.setTimeout(reloadWebIfAllowed, 200);
+      return;
+    }
+    // socket 没报 close 也可能已被静默回收（半开连接）；回前台探测一次
+    probing = true;
+    try {
+      const alive = await probeServerInfoAlive();
+      if (!alive) {
+        showWebReconnectOverlay();
+        window.setTimeout(reloadWebIfAllowed, 200);
+      }
+    } finally {
+      probing = false;
+    }
+  };
+
+  document.addEventListener("visibilitychange", () => {
+    if (document.visibilityState === "hidden") {
+      // close 可能在 hidden 期间到达但不能立即 reload（冻结态不可见）
+      socketDiedWhileHidden = socketDiedWhileHidden || document.visibilityState === "hidden";
+    } else {
+      void recoverOnVisible();
+    }
+  });
+  window.addEventListener("online", () => {
+    void recoverOnVisible();
+  });
+}
+
 async function bootstrapWebApp() {
   const params = new URLSearchParams(window.location.search);
   if (isWebOAuthCallback(params)) {
@@ -452,8 +556,9 @@ async function bootstrapWebApp() {
   }
 
   try {
+    installWebConnectionGuard();
     const services = await connectViaWebSocket(bootstrap.wsUrl, {
-      onClose: () => {},
+      onClose: (event) => handleWebTransportClosed(event),
     });
     const platform = createWebPlatform();
     document.title = "ZCode - Web + Server";
-- 
