diff --git a/packages/ui/src/lib/askUserQuestion.ts b/packages/ui/src/lib/askUserQuestion.ts
index e1afde4..42563c4 100644
--- a/packages/ui/src/lib/askUserQuestion.ts
+++ b/packages/ui/src/lib/askUserQuestion.ts
@@ -131,6 +131,28 @@ function parseJsonRecord(output: unknown): Record<string, unknown> | undefined {
   }
 }
 
+/**
+ * 从 CLI 的自然语言答案摘要中提取 `"问题"="回答"` 对。
+ * 与 ask-user-question.ts formatAskUserQuestionModelContent 的输出格式对应；
+ * 答案内含引号/逗号/等号时也按首尾引号切分，避免截断。
+ */
+function parseAnsweredTextPairs(text: string): ZCodeUserQuestionAnswers | undefined {
+  const answers: ZCodeUserQuestionAnswers = {};
+  const pairPattern = /"((?:[^"\\]|\\.)*)"\s*=\s*"((?:[^"\\]|\\.)*)"/g;
+  let matched = false;
+  for (const match of text.matchAll(pairPattern)) {
+    const rawQuestion = match[1] ?? "";
+    const rawAnswer = match[2] ?? "";
+    const question = rawQuestion.replace(/\\"/g, '"').trim();
+    const answer = rawAnswer.replace(/\\"/g, '"').trim();
+    if (question.length > 0 && !(question in answers)) {
+      answers[question] = answer;
+      matched = true;
+    }
+  }
+  return matched ? answers : undefined;
+}
+
 function readNestedAskUserQuestionAnswers(input: unknown): ZCodeUserQuestionAnswers | undefined {
   const record = parseJsonRecord(input);
   if (!record) {
@@ -170,6 +192,14 @@ function parseZCodeAskUserQuestionOutput(
 ): ZCodeUserQuestionAnswers | undefined {
   const outputRecord = parseJsonRecord(output);
   if (!outputRecord) {
+    // CLI 把 answers 序列化成自然语言摘要
+    // `User has answered your questions: "Q1"="A1", "Q2"="A2". You can now continue…`
+    // 存入 tool output（ask-user-question.ts formatAskUserQuestionModelContent）。
+    // 官方远控页能解析该格式；直连页此前只认 JSON，导致已回答的问题
+    // 显示为"未提供回答"。这里从文本中按 `"Q"="A"` 对提取。
+    if (typeof output === "string" && output.includes("User has answered your questions")) {
+      return parseAnsweredTextPairs(output);
+    }
     return undefined;
   }
 
