From 201e0c331c779b39c463fd436c4ae22ea39497c7 Mon Sep 17 00:00:00 2001
From: xhwxt <xhwxt@users.noreply.github.com>
Date: Thu, 8 Oct 2026 14:35:37 +0800
Subject: [PATCH 14/31] =?UTF-8?q?fix(web):=20ignore=20stale=20close=20even?=
 =?UTF-8?q?ts=20=E2=80=94=20stops=20reconnect=20loop=20after=20hot-swap?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

用户实机 14:29 日志实证：27 秒内 5 条 WS 反复重建。根因：热换底成功后
旧 socket 的迟到 close 事件再次触发软重连 → 又一条新 WS → 换底又 fail-closed
挂起请求 → 用户体感反复断连。

修复：连接代际（webSocketGeneration）——每次新 WS open 递增，close 回调
携带所属代，旧代 close 直接忽略。两条连接路径（首连/软重连）统一接线。
---
 packages/web/src/main.tsx | 21 ++++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/packages/web/src/main.tsx b/packages/web/src/main.tsx
index ea4c885..5b4f167 100644
--- a/packages/web/src/main.tsx
+++ b/packages/web/src/main.tsx
@@ -504,7 +504,20 @@ function removeWebReconnectBanner(): void {
   document.getElementById("zcode-web-conn-banner")?.remove();
 }
 
-function handleWebTransportClosed(event: { wasClean: boolean; code: number }): void {
+// 连接代际：每次新 WS open 递增。close 回调携带自己所属的代，
+// **旧连接迟到的 close 不触发重连**——否则热换底后旧 socket 超时断开会
+// 再次进入重连循环（用户实机 14:29 实证：27 秒内 5 条 WS 反复重建，
+// 每次换底 fail-closed 挂起请求，体感"断连"）。
+let webSocketGeneration = 0;
+
+function handleWebTransportClosed(generation: number, event: {
+  wasClean: boolean;
+  code: number;
+}): void {
+  if (generation !== webSocketGeneration) {
+    // 旧连接的迟到 close：热换底已经处理过，忽略。
+    return;
+  }
   // 正常关闭（主动登出/服务端优雅关闭）不自动重载，避免干扰正常流程。
   // 注意：手机切后台瞬间浏览器可能主动以 1001（going away）优雅关闭 ——
   // 这类"看似正常"的关闭在后台场景同样是断连，需要标记让回前台恢复路径处理。
@@ -612,8 +625,9 @@ async function attemptSoftReconnectOnce(
     // React 树零重渲（用户感知=什么都没发生）。挂起 RPC fail-closed，
     // 事件订阅经 onWebReconnected 通知重挂。
     await new Promise<void>((resolve, reject) => {
+      const generation = ++webSocketGeneration;
       connectViaWebSocket(wsUrl, {
-        onClose: (event) => handleWebTransportClosed(event),
+        onClose: (event) => handleWebTransportClosed(generation, event),
         heartbeat: withPageVisibility(() => document.visibilityState === "visible"),
         onHeartbeat: (handle) => {
           webHeartbeatHandle = handle;
@@ -732,8 +746,9 @@ async function connectWebHotSwap(
   wsUrl: string,
 ): Promise<HotSwapConnection> {
