+  const isValidNewDirectoryName = (name: string) =>
+    name.trim().length > 0 && !/[/\\]/.test(name) && name.trim() !== "." && name.trim() !== "..";
+
+  const handleCreateDirectoryCancel = () => {
+    setIsCreatingDirectory(false);
