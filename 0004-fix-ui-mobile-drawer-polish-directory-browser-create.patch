+
+  const handleCreateDirectorySubmit = async () => {
+    const name = newDirectoryName.trim();
+    if (!isValidNewDirectoryName(name) || !currentPath || loading) {
+      return;
+    }
+    setError("");
+    try {
+      await services.fileService.createDirectory({ parentPath: currentPath, name });
+      handleCreateDirectoryCancel();
+      // 创建成功后刷新当前目录，让新目录立即可见可进入。
+      await navigateTo(currentPath);
+    } catch (err) {
+      // 已存在/权限不足等服务端原始错误直接展示，与 readdir 错误共用错误行区域。
+      logger.error("[DirectoryBrowser] 创建目录失败:", err);
+      setError(intl.formatMessage({ id: "directoryBrowser.errorCreate" }, { error: String(err) }));
+    }
+  };
+
+  const handleNewDirectoryNameKeyDown = (e: React.KeyboardEvent) => {
+    if (e.key === "Escape") {
+      e.stopPropagation();
+      handleCreateDirectoryCancel();
+      return;
+    }
+    if (e.key === "Enter") {
+      e.preventDefault();
+      void handleCreateDirectorySubmit();
+    }
+  };
+
   const handleKeyDown = (e: React.KeyboardEvent) => {
     if (e.key === "Escape") onCancel();
   };
